{
	"noteConfig": {
		"noteTypes": [
			{
				"id": "Academic",
				"baseFrontMatterPath": "Templates/Academic Base Front Matter.md",
				"subtypes": [
					{
						"id": "Subject",
						"folder": "Subjects/{{subject}}",
						"template": "Templates/Subject Template.md",
						"frontMatter": [
							{
								"id": "type",
								"value": "subject",
								"type": "string"
							},
							{
								"id": "topics",
								"value": "{{topics}}",
								"type": "array"
							}
						],
						"questions": ["subject_topic_question"],
						"title": "{{subject}}"
					},
					{
						"id": "Topic",
						"folder": "Topics/{{subject}}/{{topic}}",
						"template": "Templates/Topic Template.md",
						"frontMatter": [
							{
								"id": "type",
								"value": "topic",
								"type": "string"
							},
							{
								"id": "subject",
								"value": "{{subject}}",
								"type": "link"
							},
							{
								"id": "resources",
								"value": "{{resources}}",
								"type": "array"
							}
						],
						"questions": ["subject_selection", "topic_name", "resource_question"],
						"title": "{{topic}}"
					}
				]
			}
		],
		"questions": [
			{
				"questionId": "subject_topic_question",
				"type": "nestedTpsuggester",
				"indexName": "subject",
				"nest": [
					{
						"questionId": "subject_name",
						"answerId": "subject",
						"prompt": "What subject is this?",
						"allowManualEntry": true,
						"createNewEntry": true,
						"multipleSelections": false,
						"frontMatterType": "link"
					},
					{
						"questionId": "topic_selection",
						"answerId": "topics",
						"prompt": "What topics are covered?",
						"allowManualEntry": true,
						"createNewEntry": true,
						"multipleSelections": true,
						"parentAnswerId": "subject",
						"frontMatterType": "link"
					}
				]
			},
			{
				"questionId": "subject_selection",
				"answerId": "subject",
				"type": "tpsuggester",
				"prompt": "Select the subject:",
				"indexName": "subject",
				"allowManualEntry": false,
				"multipleSelections": false
			},
			{
				"questionId": "topic_name",
				"answerId": "topic",
				"type": "inputPrompt",
				"prompt": "Enter the topic name:"
			},
			{
				"questionId": "resource_question",
				"type": "nestedTpsuggester",
				"indexName": "resource",
				"nest": [
					{
						"questionId": "resource_type",
						"answerId": "resource_type",
						"prompt": "What type of resource?",
						"choices": ["Book", "Video", "Article"],
						"allowManualEntry": false,
						"multipleSelections": false
					},
					{
						"questionId": "resource_name",
						"answerId": "resources",
						"prompt": "Enter resource name:",
						"allowManualEntry": true,
						"createNewEntry": true,
						"multipleSelections": true,
						"parentAnswerId": "resource_type",
						"frontMatterType": "link"
					}
				]
			}
		]
	},
